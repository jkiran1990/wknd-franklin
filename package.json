  "devDependencies": {
    "@babel/core": "7.18.10",
    "@babel/eslint-parser": "7.25.1",
    "@esm-bundle/chai": "4.3.4-fix.0",
    "chai": "4.3.6",
    "eslint": "8.57.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.29.1",
    "sinon": "14.0.0",
    "stylelint": "16.8.2",
